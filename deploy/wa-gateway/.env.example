# Salin ke /opt/wa-gateway/.env lalu isi nilainya.
# JANGAN commit file .env yang sudah terisi.
# Owner harus www-data, mode 600:
#   sudo chown www-data:www-data /opt/wa-gateway/.env && sudo chmod 600 /opt/wa-gateway/.env

# Gateway hanya boleh bind ke loopback. Semua akses lewat Laravel.
PORT=3001
HOST=127.0.0.1

# Wajib, minimal 24 karakter. Kalau kurang, service menolak start.
# Harus sama persis dengan WA_GATEWAY_KEY di .env Laravel.
# Generate: openssl rand -hex 32
API_KEY=

# Sesi WhatsApp (creds.json dll). Jangan pernah masuk git.
SESSION_DIR=./auth
LOG_DIR=./logs

# Anti spam-flag: jeda acak antar pesan + batas kirim per menit.
RATE_LIMIT_PER_MINUTE=20
MIN_DELAY_MS=1500
MAX_DELAY_MS=4000

# Catatan: ADMIN_USER / ADMIN_PASS sudah TIDAK dipakai sejak panel
# /wa-admin dihapus (2026-08-06). QR sekarang lewat modal di panel
# Laravel: /admin/whatsapp → tombol "Panel gateway".
